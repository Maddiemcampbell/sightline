# Supabase project settings (safe browser values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Server-only secret used by the daily detection cron endpoint.
CRON_SECRET=replace_with_at_least_32_random_characters

# Resend transactional email. Server-only except for the application URL.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Sightline <briefs@your-verified-domain.com>
APP_URL=http://localhost:3000

# Optional controlled AI analysis. Suggestions always require human review.
OPENAI_API_KEY=sk_replace_me
OPENAI_MODEL=gpt-5.6-terra

# Comma-separated Supabase Auth user UUIDs permitted to use /internal tools.
# Organization Owner status alone never grants internal platform access.
INTERNAL_ADMIN_AUTH_USER_IDS=

# V2 capability flags for deployment rollout controls.
V2_RECOMMENDED_ACTIONS_ENABLED=false
V2_AI_EMAIL_DRAFTING_ENABLED=false
V2_RISK_QUESTIONS_ENABLED=false
V2_RESOLUTION_TRACKING_ENABLED=false
V2_NOTIFICATIONS_ENABLED=false
