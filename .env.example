# Supabase project settings (safe browser values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Server-only secret used by the daily detection cron endpoint.
CRON_SECRET=replace_with_at_least_32_random_characters

# Resend invitation and Daily Brief email. Supabase Auth SMTP is configured
# separately in the hosted Supabase Dashboard.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Sightline <briefs@your-verified-domain.com>
# Production: canonical HTTPS origin without a path. Local: http://localhost:3000
APP_URL=http://localhost:3000

# Optional controlled AI analysis. Suggestions always require human review.
OPENAI_API_KEY=sk_replace_me
OPENAI_MODEL=gpt-5.6-terra

# Comma-separated Supabase Auth user UUIDs permitted to use /internal tools.
# Organization Owner status alone never grants internal platform access.
INTERNAL_ADMIN_AUTH_USER_IDS=

# Provider-neutral customer provisioning. Use mock only for local development
# and automated tests. Production validation requires stripe.
BILLING_PROVIDER=mock
# Required when BILLING_PROVIDER=stripe. All values are server-only.
# Use test with sk_test_* credentials and test-mode Price IDs locally.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ESSENTIAL_PRICE_ID=price_replace_me
STRIPE_PROFESSIONAL_PRICE_ID=price_replace_me

# Optional Procore DMSA client-credentials defaults. These are server-only.
# Leave these unset to enter connection-specific credentials in Sightline.
PROCORE_API_ENVIRONMENT=sandbox
PROCORE_SANDBOX_APP_VERSION_KEY=replace_with_procore_sandbox_app_version_key
PROCORE_CLIENT_ID=replace_with_procore_dmsa_client_id
PROCORE_CLIENT_SECRET=replace_with_procore_dmsa_client_secret
# Generate a random 32+ character secret and keep it stable for credential decryption.
PROCORE_CREDENTIAL_ENCRYPTION_KEY=replace_with_32_plus_character_secret

# Microsoft Entra multi-tenant app. Grant the application Sites.Selected.
# Add {APP_URL}/api/integrations/microsoft365/callback as an admin-consent redirect URI.
MICROSOFT365_CLIENT_ID=replace_with_entra_application_client_id
MICROSOFT365_CLIENT_SECRET=replace_with_entra_application_client_secret

# V2 capability flags for deployment rollout controls.
V2_RECOMMENDED_ACTIONS_ENABLED=false
V2_AI_EMAIL_DRAFTING_ENABLED=false
V2_RISK_QUESTIONS_ENABLED=false
V2_RESOLUTION_TRACKING_ENABLED=false
V2_NOTIFICATIONS_ENABLED=false
